generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- NextAuth required tables ----------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts           Account[]
  sessions           Session[]
  workoutLogs        WorkoutLog[]
  weightLogs         WeightLog[]
  checklistEntries   ChecklistEntry[]
  nutritionSettings  NutritionSettings?

  createdAt DateTime @default(now())
}

// ---------- App data, always scoped to a userId ----------

model WorkoutLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise  String   // fixed slug, validated server-side against an allow-list
  date      String   // ISO yyyy-mm-dd
  sets      Json     // [{ weight: number, reps: number }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, exercise, date])
  @@index([userId, exercise])
}

model NutritionSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  activity  String
  goal      String
  calories  Int
  protein   Int
  water     Int
  updatedAt DateTime @updatedAt
}

model WeightLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // ISO yyyy-mm-dd
  weight Float

  @@unique([userId, date])
}

model ChecklistEntry {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     String  // ISO yyyy-mm-dd
  protein  Boolean @default(false)
  calories Boolean @default(false)
  creatine Boolean @default(false)
  water    Boolean @default(false)

  @@unique([userId, date])
}
